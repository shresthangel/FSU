rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmailAccount() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function verifiedStudent() {
      return verifiedEmailAccount()
        && exists(/databases/$(database)/documents/studentVerifications/$(request.auth.uid))
        && get(/databases/$(database)/documents/studentVerifications/$(request.auth.uid)).data.status == 'approved';
    }

    function isAdmin() {
      return verifiedEmailAccount()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsSupportRequest() {
      return verifiedStudent() && resource.data.userId == request.auth.uid;
    }

    match /admins/{uid} {
      allow get: if verifiedEmailAccount() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /portalContent/{contentId} {
      allow get: if contentId == 'public';
      allow list: if false;
      allow create, update, delete: if contentId == 'public' && isAdmin();
    }

    match /events/{eventId}/registrations/{studentUid} {
      allow get: if isAdmin() || (verifiedStudent() && request.auth.uid == studentUid);
      allow list: if isAdmin();
      allow create: if verifiedStudent()
        && request.auth.uid == studentUid
        && request.resource.data.keys().hasOnly([
          'eventId', 'userUid', 'name', 'email', 'phone', 'dept', 'notes', 'date'
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.userUid == studentUid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone.matches('^[0-9]{10}$')
        && request.resource.data.dept is string
        && request.resource.data.dept.size() > 0
        && request.resource.data.dept.size() <= 100
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.date is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /events/{eventId}/feedback/{studentUid} {
      allow get: if isAdmin() || (verifiedStudent() && request.auth.uid == studentUid);
      allow list: if isAdmin();
      allow create: if verifiedStudent()
        && request.auth.uid == studentUid
        && request.resource.data.keys().hasOnly([
          'eventId', 'userUid', 'choice', 'suggestion', 'submittedAt'
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.userUid == studentUid
        && request.resource.data.choice in ['Yes', 'No', 'Maybe']
        && request.resource.data.suggestion is string
        && request.resource.data.suggestion.size() <= 1000
        && request.resource.data.submittedAt is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /lostFoundPosts/{postId} {
      allow get: if isAdmin() || resource.data.approved == true
        || (verifiedStudent() && resource.data.ownerUid == request.auth.uid);
      allow list: if isAdmin() || resource.data.approved == true;
      allow create: if verifiedStudent()
        && request.resource.data.keys().hasOnly([
          'id', 'type', 'title', 'location', 'contact', 'description', 'date',
          'approved', 'ownerUid', 'photo', 'photoPath'
        ])
        && request.resource.data.id == postId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['lost', 'found']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 160
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 254
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.date is string
        && request.resource.data.approved == true
        && (!('photo' in request.resource.data) || request.resource.data.photo is string)
        && (!('photoPath' in request.resource.data) || request.resource.data.photoPath is string);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
        && request.resource.data.approved is bool;
      allow delete: if isAdmin();
    }

    match /studentVerifications/{uid} {
      allow create: if verifiedEmailAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'studentId', 'status', 'submittedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() >= 3
        && request.resource.data.studentId.size() <= 64
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt is timestamp;
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if (
          isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedAt is timestamp
          && request.resource.data.reviewedBy == request.auth.uid
        ) || (
          verifiedEmailAccount()
          && request.auth.uid == uid
          && resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['studentId', 'status', 'submittedAt'])
          && request.resource.data.email == resource.data.email
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.studentId is string
          && request.resource.data.studentId.size() >= 3
          && request.resource.data.studentId.size() <= 64
          && request.resource.data.status == 'pending'
          && request.resource.data.submittedAt is timestamp
        );
      allow delete: if false;
    }

    match /users/{uid} {
      allow create: if verifiedStudent()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'studentId', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.studentId == 'FSU-' + request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.createdAt is timestamp;
      allow read: if (verifiedStudent() && request.auth.uid == uid) || isAdmin();
      allow update: if verifiedStudent()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if false;
    }

    match /supportRequests/{requestId} {
      allow create: if verifiedStudent()
        && request.resource.data.keys().hasOnly([
          'userId', 'studentId', 'category', 'summary', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.studentId == 'FSU-' + request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.category in [
          'Help or guidance', 'Infrastructure', 'Washroom / Cleanliness',
          'Fee / Administration', 'Unfair treatment', 'Academic',
          'Suggestion', 'Other'
        ]
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 4000
        && request.resource.data.status == 'Received'
        && request.resource.data.createdAt is timestamp;
      allow get, list: if isAdmin() || ownsSupportRequest();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'assignedTo', 'updatedAt'])
        && request.resource.data.status in ['Received', 'In progress', 'Solved'];
      allow delete: if false;

      match /messages/{messageId} {
        function parentRequest() {
          return get(/databases/$(database)/documents/supportRequests/$(requestId));
        }

        function canReadThread() {
          return isAdmin()
            || (verifiedStudent() && parentRequest().data.userId == request.auth.uid);
        }

        allow get, list: if canReadThread();
        allow create: if canReadThread()
          && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'body', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (isAdmin() ? 'admin' : 'student')
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }
  }
}
